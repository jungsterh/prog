# Copy to .env for local development. Never commit real values.

# M0: the server has no authentication, so it binds to loopback only.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Extra Host-header names to accept, comma-separated (for example a dev tunnel hostname).
MCP_ALLOWED_HOSTS=

# Planned for later milestones (not read by M0 code):
# MCP_PUBLIC_BASE_URL=https://mcp.example.invalid
# DATABASE_URL=postgres://user:password@localhost:5432/ai_workspace
# AUTH_ISSUER=
# AUTH_AUDIENCE=
